// Postgres (Neon) for both local dev and production. DATABASE_URL is the pooled
// connection (host contains "-pooler") used by the app at runtime; the direct
// connection is used by `prisma db push` / migrations. Neon's Vercel integration
// injects both DATABASE_URL and DATABASE_URL_UNPOOLED automatically.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model MenuItem {
  id          String   @id @default(cuid())
  menuType    String // "lunch" | "dinner" | "cocktail" | "specials"
  section     String? // e.g. "Starters", "Mains", "Drafts"
  name        String
  description String?
  price       String? // free-form so "$14", "14", or "Market" all work
  tags        String[] @default([]) // dietary: "veg" | "vgn" | "gf" | "gfo"
  sortOrder   Int      @default(0)
  eightySixedAt DateTime? // null = available; set = 86'd (sold out, remembered)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([menuType, sortOrder])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime // stored at 12:00 UTC for the calendar day
  timeLabel   String? // free-form, e.g. "7:00 PM" or "6–9 PM"
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
}

// Simple key/value flags (e.g. "specials_enabled" = "true"/"false").
model Setting {
  key   String @id
  value String
}

// A menu captured from a photo, awaiting staff approval before it's published.
// One pending capture per Telegram chat.
model PendingMenu {
  chatId    String   @id
  menuType  String
  items     String // JSON-encoded [{ section?, name, description?, price?, tags[] }]
  summary   String
  messageId Int? // Telegram message id holding the Publish/Discard buttons
  updatedAt DateTime @updatedAt
}

// Buffer for Telegram albums (multiple photos sent at once). Each album item
// arrives as a separate webhook sharing a media_group_id; we stash one row per
// photo, then one invocation debounces, claims the set, and OCRs them together.
model AlbumPhoto {
  id           String   @id @default(cuid())
  chatId       String
  mediaGroupId String
  fileId       String // Telegram file_id, re-downloaded at process time
  caption      String? // album caption, if any (Telegram attaches it to one item)
  createdAt    DateTime @default(now())

  @@index([chatId, mediaGroupId])
}

// An Instagram post the event poller has already evaluated, so the daily cron
// doesn't re-read it. id = Instagram media id (cf. Untappd's checkinId dedup).
model ProcessedPost {
  id          String   @id // Instagram media id
  permalink   String?
  processedAt DateTime @default(now())
}

// An event detected in an Instagram caption, staged for a Publish/Discard tap
// in Telegram before it goes on the events page. Mirrors PendingMenu.
model PendingEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime // noon UTC, same convention as Event
  timeLabel   String?
  location    String?
  sourceUrl   String? // Instagram permalink, shown in the review message
  chatId      String
  messageId   Int? // Telegram message id holding the Publish/Discard buttons
  createdAt   DateTime @default(now())
}
