# --- Anthropic ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model used by the agent (vision OCR + instruction parsing)
ANTHROPIC_MODEL=claude-opus-4-7

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# A random string you choose; Telegram echoes it back on every webhook call so
# we can verify requests really came from Telegram. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat IDs allowed to control the site. Message the bot and it
# will reply with your chat ID, then paste it here. Example: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Database (Neon Postgres) ---
# On Vercel, the Neon integration injects BOTH of these automatically — no need
# to set them by hand. For local dev, copy them from the Neon dashboard.
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/bierhaul?sslmode=require"
# Direct connection (no "-pooler") — used by `prisma db push` / migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/bierhaul?sslmode=require"

# --- Untappd (optional — placeholder until UTFB Premium is set up) ---
# See PUNCHLIST.md. Until these are set, the beer list and leaderboard show
# "coming soon" placeholders.
# iframe src from UTFB → Website Embed (lights up the On Tap beer list):
UNTAPPD_MENU_EMBED_URL=
# Read-only token + location id from UTFB → API (powers the leaderboard).
# Note: location id is NOT the public venue id (11290340).
UNTAPPD_API_TOKEN=
UNTAPPD_LOCATION_ID=

# --- Deployment ---
# Public HTTPS base URL of the deployed site (used to register the webhook).
# Example: https://bierhaul.vercel.app
PUBLIC_URL=
