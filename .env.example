# --- Anthropic ---
# Create a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Model routing for the agent. Photos (OCR) use the vision model; text-only
# requests use the cheaper text model. Both optional — sensible defaults below.
ANTHROPIC_MODEL_VISION=claude-opus-4-7
ANTHROPIC_MODEL_TEXT=claude-sonnet-4-6
# Optional: set ANTHROPIC_MODEL to force ONE model for everything (disables routing).
# ANTHROPIC_MODEL=

# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# A random string you choose; Telegram echoes it back on every webhook call so
# we can verify requests really came from Telegram. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat IDs allowed to control the site. Message the bot and it
# will reply with your chat ID, then paste it here. Example: 123456789,987654321
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Database (Neon Postgres) ---
# On Vercel, the Neon integration injects BOTH of these automatically — no need
# to set them by hand. For local dev, copy them from the Neon dashboard.
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-2.aws.neon.tech/bierhaul?sslmode=require"
# Direct connection (no "-pooler") — used by `prisma db push` / migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/bierhaul?sslmode=require"

# --- Untappd (optional — placeholder until UTFB Premium is set up) ---
# See PUNCHLIST.md. Until these are set, the beer list and leaderboard show
# "coming soon" placeholders.
# iframe src from UTFB → Website Embed (lights up the On Tap beer list):
UNTAPPD_MENU_EMBED_URL=
# Read-only token + location id from UTFB → API (powers the leaderboard).
# Note: location id is NOT the public venue id (11290340).
UNTAPPD_API_TOKEN=
UNTAPPD_LOCATION_ID=

# --- Instagram event sync (optional — ships DISABLED) ---
# Auto-detects events in the restaurant's OWN Instagram posts and stages them for
# a Publish/Discard tap in Telegram. Requires a Business/Creator IG account + the
# Instagram Graph API. Full setup: see INTEGRATIONS.md. Stays OFF until BOTH the
# token/user id below are set AND INSTAGRAM_EVENT_SYNC_ENABLED=true.
INSTAGRAM_EVENT_SYNC_ENABLED=false
# Long-lived Graph API access token (~60-day expiry — must be refreshed).
INSTAGRAM_ACCESS_TOKEN=
# The Instagram-business account id (NOT the @handle).
INSTAGRAM_USER_ID=
# Optional Graph API version override (default v21.0).
# INSTAGRAM_GRAPH_VERSION=v21.0

# --- Cron ---
# Secret protecting the scheduled jobs (e.g. /api/cron/instagram). On Vercel,
# set this and the platform sends it as `Authorization: Bearer <CRON_SECRET>`.
# Leave blank to keep cron endpoints disabled (they return 403).
CRON_SECRET=

# --- Admin ---
# Secret for the one-time POST /api/reseed endpoint, which resets the live menus
# + events to the seeded defaults. Leave blank to keep the endpoint disabled.
RESEED_SECRET=

# --- Deployment ---
# Public HTTPS base URL of the deployed site (used to register the webhook).
# Example: https://bierhaul.vercel.app
PUBLIC_URL=
